{
    "name": "hughcube/laravel-lark",
    "description": "Lark (Feishu) custom robot/webhook notifications for Laravel & Lumen.",
    "keywords": ["laravel", "lumen", "lark", "feishu", "robot", "webhook", "notification"],
    "license": "MIT",
    "authors": [
        {
            "name": "hugh.li",
            "email": "hugh.li@foxmail.com"
        }
    ],
    "require": {
        "php": "8.*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "*",
        "monolog/monolog": "*",
        "hughcube/laravel-service-support": "^1.0"
    },
    "require-dev": {
        "laravel/framework": "*",
        "laravel/lumen-framework": "*",
        "squizlabs/php_codesniffer": "*",
        "phpstan/phpstan": "*",
        "orchestra/testbench": "*"
    },
    "autoload": {
        "psr-4": {
            "HughCube\\Laravel\\Lark\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HughCube\\Laravel\\Lark\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HughCube\\Laravel\\Lark\\ServiceProvider"
            ],
            "aliases": {
                "Lark": "HughCube\\Laravel\\Lark\\Lark"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "check-style": "phpcs",
        "fix-style": "phpcbf"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
